# ==============================================================================
# SOC AUTOMATION PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your API keys.
# Unused/empty keys will automatically degrade the respective component to Mock Mode.
# ==============================================================================

# API Keys (e.g. e56809fabbd1...)
SOC_VIRUSTOTAL_API_KEY=
SOC_ABUSEIPDB_API_KEY=
SOC_ALIENVAULT_API_KEY=
SOC_GEMINI_API_KEY=

# Global operation mode. Set to 'true' to simulate APIs and force mock behavior,
# or 'false' to query real production endpoints.
SOC_MOCK_MODE=false

# Root path for file integrity and change monitoring.
# By default, monitors the 'monitored_directory' folder in the workspace.
SOC_FILE_MONITOR_PATH=./monitored_directory
